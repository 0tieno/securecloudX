# ─── Supabase ────────────────────────────────────────────────
# 1. Go to https://supabase.com and create a new project.
# 2. Find these values at: Project Settings → API (or the "Connect" button)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# ─── Keverd device security ───────────────────────────────────
# Public key is safe for browser use. Use a test key for local development.
VITE_KEVERD_PUBLIC_KEY=kv_pk_test_your-public-key-here
# The secret key belongs only in Supabase Edge Function secrets; never add it here.

# ─── GitHub OAuth ─────────────────────────────────────────────
# The GitHub OAuth Client ID and Secret go into Supabase, NOT into this file.
# In your Supabase project:
#   Authentication → Providers → GitHub → Enable
#   Paste your GitHub OAuth App Client ID and Secret there.
#   Set the Supabase Callback URL to: https://<your-ref>.supabase.co/auth/v1/callback
#
# To create a GitHub OAuth App:
#   https://github.com/settings/developers → New OAuth App
#   Homepage URL: http://localhost:5173
#   Authorization callback URL: https://<your-ref>.supabase.co/auth/v1/callback

# ─── Admin ────────────────────────────────────────────────────
# The Supabase user UUID of the admin user (shown on /admin route)
VITE_ADMIN_UID=your-admin-user-uuid-here
